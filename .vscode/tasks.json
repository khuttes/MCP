{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Helpyard: Start Bridge",
            "type": "process",
            "command": "${env:WINDIR}\\System32\\WindowsPowerShell\\v1.0\\powershell.exe",
            "args": [
                "-NoProfile",
                "-ExecutionPolicy",
                "Bypass",
                "-File",
                "${workspaceFolder}\\bridge.ps1",
                "-OpenDashboard"
            ],
            "problemMatcher": [],
            "presentation": {
                "echo": true,
                "reveal": "always",
                "focus": true,
                "panel": "dedicated",
                "clear": false
            }
        }
    ]
}
