{
    // Use IntelliSense to learn about possible attributes.
    // Hover to view descriptions of existing attributes.
    // For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Helpyard: Preview Static Dashboard (No API)",
            "type": "msedge",
            "request": "launch",
            "file": "${workspaceFolder}\\pc-control-dashboard.html",
            "webRoot": "${workspaceFolder}"
        },
        {
            "name": "Helpyard: Launch Legacy PowerShell Bridge",
            "type": "PowerShell",
            "request": "launch",
            "script": "${workspaceFolder}\\bridge.ps1",
            "args": [
                "-OpenDashboard"
            ]
        }
    ]
}