{
    // Use IntelliSense to learn about possible attributes.
    // Hover to view descriptions of existing attributes.
    // For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Helpyard: Open Dashboard",
            "type": "msedge",
            "request": "launch",
            "file": "${workspaceFolder}\\pc-control-dashboard.html",
            "webRoot": "${workspaceFolder}"
        },
        {
            "name": "Helpyard: Start Local Bridge",
            "type": "PowerShell",
            "request": "launch",
            "script": "${workspaceFolder}\\bridge.ps1",
            "args": []
        },
        {
            "name": "PowerShell: Launch Current File",
            "type": "PowerShell",
            "request": "launch",
            "script": "${file}",
            "args": []
        }
    ],
    "compounds": [
        {
            "name": "Helpyard: Full Local Development",
            "configurations": [
                "Helpyard: Start Local Bridge",
                "Helpyard: Open Dashboard"
            ],
            "stopAll": true
        }
    ]
}